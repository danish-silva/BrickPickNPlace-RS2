<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>brick_gui</name>
  <version>0.0.0</version>
  <description>PyQt5 GUI for the LeBrick n Place pick-and-place system</description>
  <maintainer email="hari.mahadevan@student.uts.edu.au">Hari Mahadevan</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <!-- PyQt5 is a system dependency: sudo apt install python3-pyqt5
       or: pip install pyqt5 -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
